#!/usr/bin/env node
import { spawn } from 'node:child_process'
import fs from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'

const BASE = 'http://127.0.0.1:5199'
// PATH に置いたシンボリックリンクから呼ばれても、リポジトリの場所を引けるようにする
const root = path.resolve(path.dirname(fs.realpathSync(fileURLToPath(import.meta.url))), '..')
const status = () => fetch(BASE + '/api/status').then((r) => r.json()).catch(() => null)
const sleep = (ms) => new Promise((r) => setTimeout(r, ms))

const [cmd, n = ''] = process.argv.slice(2)
if (!['open', 'wait'].includes(cmd) || !/^\d*$/.test(n)) {
  console.log(`usage:
  croquis open [n]   ビューアを開く（Vite が動いていなければ起動する）
  croquis wait [n]   未読のフィードバックが届くまで待ち、届いたら JSON を出力して終了する（n を省くと全クロッキー）`)
  process.exit(cmd ? 1 : 0)
}

if (cmd === 'wait') {
  const get = (p) => fetch(`${BASE}/api/${p}`).then((r) => r.json())
  for (;;) {
    let fbs
    try {
      const ids = n ? [n] : (await get('croquis')).map((c) => c.id)
      fbs = (await Promise.all(ids.map((id) => get(`croquis/${id}/feedback`)))).flat()
    } catch {
      console.error('サーバーに繋がりません。croquis open で起動してください')
      process.exit(1)
    }
    // 存在しない n のときは {error} が返る。配列でなければ待ち続けても来ない
    if (fbs.some((f) => f.error)) {
      console.error(`クロッキー ${n} がありません`)
      process.exit(1)
    }
    if (fbs.length) {
      console.log(JSON.stringify(fbs, null, 2))
      process.exit(0)
    }
    await sleep(1000)
  }
}

let s = await status()
if (!s) {
  const vite = path.join(root, 'node_modules/.bin/vite')
  if (!fs.existsSync(vite)) {
    console.error(`vite がありません。${root} で pnpm install を実行してください`)
    process.exit(1)
  }
  const logFile = path.join(root, '.croquis/vite.log')
  fs.mkdirSync(path.dirname(logFile), { recursive: true })
  const log = fs.openSync(logFile, 'a')
  spawn(vite, { cwd: root, detached: true, stdio: ['ignore', log, log] }).unref()
  for (let i = 0; i < 50 && !(s = await status()); i++) await sleep(200)
  if (!s) {
    console.error(`Vite が起動しません。ログ: ${logFile}`)
    process.exit(1)
  }
  // 前から開いていたタブがあれば、つなぎ直してくるのを待つ
  await sleep(2500)
  s = await status()
}

if (s.open) console.log('ビューアはすでに開いています')
else spawn(process.platform === 'darwin' ? 'open' : 'xdg-open', [`${BASE}/#${n}`], { stdio: 'inherit' })
